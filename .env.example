# =============================================================
# Markmobil – Environment Configuration Template
# =============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control!
# =============================================================

# --- PeerTube: Domain -------------------------------------------
PEERTUBE_WEBSERVER_HOSTNAME=your-domain.example.com

# --- PeerTube: Database -----------------------------------------
PEERTUBE_DB_USERNAME=peertube
PEERTUBE_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PEERTUBE_DB_NAME=peertube

# --- PeerTube: App secret (generate with: openssl rand -hex 32) -
PEERTUBE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# --- PeerTube: Admin Account ------------------------------------
PEERTUBE_ADMIN_EMAIL=admin@your-domain.example.com

# --- PeerTube: SMTP (optional, for password resets) -------------
PEERTUBE_SMTP_FROM=noreply@your-domain.example.com
PEERTUBE_SMTP_HOSTNAME=smtp.your-provider.example.com
PEERTUBE_SMTP_PORT=587
PEERTUBE_SMTP_USERNAME=CHANGE_ME_SMTP_USER
PEERTUBE_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# --- Local Video Storage ----------------------------------------
# Absolute path on the HOST where videos are stored persistently.
VIDEO_STORAGE_PATH=/opt/markmobil/videos

# --- Plausible Analytics ----------------------------------------
PLAUSIBLE_DOMAIN=stats.your-domain.example.com
PLAUSIBLE_DB_USERNAME=plausible
PLAUSIBLE_DB_PASSWORD=CHANGE_ME_PLAUSIBLE_DB_PASSWORD
# Generate with: openssl rand -base64 64 | tr -d '\n'
PLAUSIBLE_SECRET_KEY_BASE=CHANGE_ME_GENERATE_WITH_OPENSSL
